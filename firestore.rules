rules_version = '2';

// سوق الشرق — قواعد Firestore
// - قراءة عامة لكتالوج المحتوى (إعلانات/متاجر/منتجات/تقييمات/تصنيفات).
// - مقيد: users (للمالك أو الإدارة)، subscriptions (للمالك أو الإدارة)،
//   featured_requests (النشطة للجميع — المعلقة للمالك أو الإدارة).
// - الكتابة على المحتوى المملوك للمالك (ownerUid) أو الإدارة.
// - مستندات المستخدمين: الإنشاء لمن يملك الـuid، التحديث للمالك أو الإدارة، الحذف للإدارة.
// - isAdmin يشترط بريدًا موثّقًا (email_verified).
// - announcements/banners/pharmacies/labs/featured_settings: الكتابة للإدارة فقط.
// - doctors: التسجيل الذاتي — أي مسجل ينشئ طلبًا (pending حصرًا)، والقراءة العامة للمعتمدين فقط، والاعتماد للإدارة.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'drbasharmohammad@gmail.com';
    }

    // المالك الحالي للمستند الموجود
    function ownsDoc() {
      return isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // منشئ المستند الجديد يملكه
    function createsOwnDoc() {
      return isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // ——— محتوى المستخدمين: قراءة عامة، كتابة للمالك أو الإدارة ———
    match /listings/{docId} {
      allow read: if true;
      allow create: if createsOwnDoc();
      allow update, delete: if ownsDoc() || isAdmin();
    }

    match /stores/{docId} {
      allow read: if true;
      allow create: if createsOwnDoc();
      allow update, delete: if ownsDoc() || isAdmin();
    }

    match /products/{docId} {
      allow read: if true;
      allow create: if createsOwnDoc();
      allow update, delete: if ownsDoc() || isAdmin();
    }

    match /reviews/{docId} {
      allow read: if true;
      allow create: if createsOwnDoc();
      allow update, delete: if ownsDoc() || isAdmin();
    }

    // اشتراكات: القراءة للمالك أو الإدارة فقط (إيصالات الدفع حساسة)
    match /subscriptions/{docId} {
      allow read: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if createsOwnDoc();
      allow update, delete: if ownsDoc() || isAdmin();
    }

    // طلبات التمييز: النشطة معلنة للجميع (كاروسيل الرئيسية) —
    // المعلقة/المرفوضة/المنتهية للمالك أو الإدارة فقط
    match /featured_requests/{docId} {
      allow read: if resource.data.status == 'active'
        || (isSignedIn()
            && (resource.data.ownerUid == request.auth.uid || isAdmin()));
      allow create: if createsOwnDoc();
      allow update, delete: if ownsDoc() || isAdmin();
    }

    // تصنيفات داخل المتجر — ينشئها التاجر (v8)
    match /store_categories/{docId} {
      allow read: if true;
      allow create: if createsOwnDoc();
      allow update, delete: if ownsDoc() || isAdmin();
    }

    // ——— المستخدمون: القراءة للمالك أو الإدارة فقط (أرقام الهواتف حساسة) ———
    match /users/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && uid == request.auth.uid;
      // المالك يحدّث بياناته لكن لا يمنح نفسه صلاحية الإدارة
      allow update: if isAdmin()
        || (isSignedIn() && uid == request.auth.uid
            && request.resource.data.isAdmin == resource.data.isAdmin);
      allow delete: if isAdmin();
    }

    // ——— محتوى الإدارة فقط (قراءة عامة) ———
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // الدليل الطبي — التسجيل الذاتي بموافقة الإدارة (v14)
    match /doctors/{docId} {
      // القراءة: المعتمدون للجميع — المعلقة للإدارة أو صاحب الطلب فقط
      allow read: if resource.data.get('status', 'approved') == 'approved'
        || isAdmin()
        || (isSignedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      // الإنشاء: أي مستخدم مسجل — طلب بحالة pending حصرًا وبملكيته
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerUid == request.auth.uid;
      // الاعتماد/التعديل/الحذف: الإدارة فقط
      allow update, delete: if isAdmin();
    }

    match /pharmacies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /labs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /featured_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
